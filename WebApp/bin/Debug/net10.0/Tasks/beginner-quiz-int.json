    "title": "The first step - ints",
    "description": "As your quest to become a master begins, the path ahead awaits. This is your first step toward mastering ints..",
    "difficulty": "apprentice",
    "questions": [
        {
            "id": "q1",
            "type": "multipleChoice",
            "text": "Which keyword is used to declare an Integer in Java?",
            "points": 1,
            "options": [
                {
                    "id": "a",
                    "text": "int"
                },
                {
                    "id": "b",
                    "text": "Integer"
                },
                {
                    "id": "c",
                    "text": "integer"
                },
                {
                    "id": "d",
                    "text": "double"
                }
            ],
            "correctOptionId": "a",
            "explaination": "When declaring an Integer in Java, you use 'int'. Example: int questsCompleted = 2;"
        },
        {
            "id": "q2",
            "type": "multipleChoice",
            "text": "Which value is a valid int in Java?",
            "points": 1,
            "options": [
                {
                    "id": "a", 
                    "text": "\"5\""
                },
                {
                    "id": "b", 
                    "text": "true"
                },
                {
                    "id": "c", 
                    "text": "7.5"
                },
                {
                    "id": "d", 
                    "text": "10"
                }
            ],
            "correctOptionId": "d",
            "explaination": "An int stores whole numbers, so 10 is a valid integer value. If you want to declare a decimal, you can use float or double."
        },
        {
            "id": "q3",
            "type": "multipleChoice",
            "text": "Which line correctly declares an int called health?",
            "points": 1,
            "options": [
                {
                    "id": "a", 
                    "text": "health int = 100;"
                },
                {
                    "id": "b", 
                    "text": "int health = 100;"
                },
                {
                    "id": "c", 
                    "text": "int = health 100;"
                },
                {
                    "id": "d", 
                    "text": "health = int 100;"
                }
            ],
            "correctOptionId": "b",
            "explaination": "In Java, the type comes before the variable name: int health = 100;"
        },
        {
            "id": "q4",
            "type": "multipleChoice",
            "text": "What is the value of score after this code runs? int score = 5; score = 30;",
            "points": 1,
            "options": [
                {
                    "id": "a",
                    "text": "5"
                },
                {
                    "id": "b",
                    "text": "30"
                },
                {
                    "id": "c",
                    "text": "35"
                },
                {
                    "id": "d",
                    "text": "25"
                }
            ],
            "correctOptionId": "b",
            "explaination": "The last assignment is the one that counts. Since 'score' gets changed to 30, it stays as 30 even though it was originally assigned as 5."
        },
        {
            "id": "q5",
            "type": "multipleChoice",
            "text": "Which declaration correctly stores a negative whole number?",
            "points": 1,
            "options": [
                {
                    "id": "a", 
                    "text": "int celsius = -6;"
                },
                {
                    "id": "b", 
                    "text": "int celsius = -9.5;"
                },
                {
                    "id": "c", 
                    "text": "int celsius = \"-6\";"
                },
                {
                    "id": "d", 
                    "text": "int celsius = negative;"
                }
            ],
            "correctOptionId": "a",
            "explaination": "-6 is a correctly stored int. If you want to declare a decimal, such as -9.5, you can use float or double."
        }
