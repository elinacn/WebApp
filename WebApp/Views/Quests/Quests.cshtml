@using WebApp.Models
@using WebApp.ViewModels
@model QuestsPageViewModel
@{
    ViewData["Title"] = "Quests";
}

<link rel="stylesheet" href="~/css/quests.css" asp-append-version="true" />

<div class="quests-page">
    <partial name="_QuestsSidebar" model="Model" />

    <div class="quests-main">
        @if (Model.ActiveSection == "create")
        {
            <partial name="_CreateQuestForm" model="Model" />
        }
        else
        {
        <form class="quests-filter" method="get" asp-controller="Quests" asp-action="Quests">
            <input type="hidden" name="section" value="@Model.ActiveSection" />

            <input class="quests-search"
                   type="text"
                   name="searchText"
                   value="@Model.Filter.SearchText"
                   placeholder="Search quests" />

            <select class="quests-difficulty" name="difficulty">
                <option value="">All</option>
                @foreach (Difficulty level in Enum.GetValues<Difficulty>())
                {
                    <option value="@level" selected="@(Model.Filter.Difficulty == level ? "selected" : null)">@level</option>
                }
            </select>

            <button class="quests-apply" type="submit">Apply</button>
            <a class="quests-reset" asp-controller="Quests" asp-action="Quests" asp-route-section="@Model.ActiveSection">Reset</a>
        </form>

        @if (Model.ActiveSection == "library")
        {
            <section class="quests-section" data-bs-theme="dark">
                <h2 class="quests-heading">My Quests</h2>

                @if (!Model.MyQuests.Any())
                {
                    <p>No quests yet.</p>
                }
                else
                {
                    <div class="quests-grid">
                        @foreach (var quest in Model.MyQuests)
                        {
                            <article class="quest-card">
                                <h3 class="quest-card-title">@quest.Title</h3>
                                <p class="quest-card-meta">@quest.Difficulty · @quest.TotalPoints pts</p>
                                <p class="quest-card-meta">@quest.QuestionCount questions</p>
                                <p class="quest-card-code">Created @quest.CreatedAt.ToString("dd'/'MM'/'yyyy")</p>
                                <div class="quest-card-actions">
                                    <a asp-controller="Quests" asp-action="Edit" asp-route-id="@quest.Id">Edit</a>
                                    <a asp-controller="Quests" asp-action="Delete" asp-route-id="@quest.Id">Delete</a>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        }

        @if (Model.ActiveSection == "explore")
        {
        <section class="quests-section" data-bs-theme="dark">
            <h2 class="quests-heading">All Quests</h2>
            @if (Model.ExploreQuests.Count == 0)
            {
            <p>No quests found. Create one from the sidebar.</p>
            }
            else
            {
                <div class="quests-grid">
                    @foreach (var quest in Model.ExploreQuests)
                    {
                    <partial name="_QuestCard" model="quest" />
                    }
                </div>
            }
        </section>

            <section class="quests-section">
                <h2 class="quests-heading">Featured Quests</h2>
                @if (Model.FeaturedQuests.Count == 0)
                {
                    <p>No featured quests yet.</p>
                }
                else
                {
                    <div class="quests-row">
                        @foreach (var quest in Model.FeaturedQuests)
                        {
                            <partial name="_QuestCard" model="quest" />
                        }
                    </div>
                }
            </section>

            <section class="quests-section">
                <h2 class="quests-heading">Recommended Quests</h2>
                @if (Model.RecommendedQuests.Count == 0)
                {
                    <p>No recommended quests yet.</p>
                }
                else
                {
                    <div class="quests-row">
                        @foreach (var quest in Model.RecommendedQuests)
                        {
                            <partial name="_QuestCard" model="quest" />
                        }
                    </div>
                }
            </section>
        }

        @if (Model.ActiveSection == "saved")
        {
            <section class="quests-section">
                <h2 class="quests-heading">Saved Quests</h2>
                @if (Model.SavedQuests.Count == 0)
                {
                    <p>No saved quests yet.</p>
                }
                else
                {
                    <div class="quests-grid">
                        @foreach (var quest in Model.SavedQuests)
                        {
                            <partial name="_QuestCard" model="quest" />
                        }
                    </div>
                }
            </section>
        }
        }
    </div>
</div>
