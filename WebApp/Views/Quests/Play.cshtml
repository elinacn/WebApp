@using WebApp.ViewModels
@model PlayQuestViewModel
@{
    ViewData["Title"] = Model.Title;
}

<link rel="stylesheet" href="~/css/quests.css" asp-append-version="true" />

<div class="quests-page">
    <div class="quests-main">
        <section class="quests-create-panel">
            <h2 class="quests-heading">@Model.Title</h2>
            <p class="quests-create-hint">@Model.Difficulty</p>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="quests-create-hint">@Model.Description</p>
            }

            @if (Model.Submitted)
            {
                var result = Model.Result;
                var outcome = result is null || result.MaxScore <= 0 ? null
                    : result.Score <= 0 ? "none"
                    : result.Score >= result.MaxScore ? "perfect"
                    : result.Score * 2 >= result.MaxScore ? "high"
                    : "low";
                <div class="quests-play-result" role="status" data-quest-outcome="@outcome">
                    @if (result is null)
                    {
                        <p class="text-danger">@Model.ResultError</p>
                    }
                    else
                    {
                        <p class="quests-play-score">You scored <strong>@result.Score of @result.MaxScore</strong> points.</p>
                        @if (result.PointsAwarded > 0)
                        {
                            <p>+@result.PointsAwarded code points! You now have @result.TotalPoints in total.</p>
                        }
                        else if (result.FirstCompletion)
                        {
                            <p>No code points this time. Try again to earn some.</p>
                        }
                        else
                        {
                            <p>No new code points: your best on this quest is @result.BestScore of @result.MaxScore. Beat it to earn the difference.</p>
                        }
                    }
                </div>
            }

            <form class="quests-create-form" method="post" asp-controller="Quests" asp-action="Play" asp-route-id="@Model.Id">
                @for (var i = 0; i < Model.Questions.Count; i++)
                {
                    var q = Model.Questions[i];

                    <fieldset class="quests-create-block" disabled="@Model.Submitted">
                        <div class="quests-q-header">
                            <h4 class="quests-q-title">Question @(i + 1)</h4>
                            @if (Model.Submitted)
                            {
                                <span class="quests-play-badge @(q.IsCorrect ? "is-correct" : "is-wrong")">
                                    @(q.IsCorrect ? "Correct" : "Incorrect")
                                </span>
                            }
                        </div>

                        <p class="quests-play-question">@q.Question</p>
                        <input type="hidden" name="answers[@i].QuestionId" value="@q.Id" />

                        @if (q.Type == "freeText")
                        {
                            <input type="text" class="quests-play-text"
                                   name="answers[@i].Text"
                                   value="@q.TextAnswer"
                                   placeholder="Your answer"
                                   autocomplete="off" />

                            @if (Model.Submitted && !q.IsCorrect)
                            {
                                <p class="quests-play-answer">Accepted answer(s): @string.Join(", ", q.AcceptedAnswers)</p>
                            }
                        }
                        else if (q.Type == "code")
                        {
                            <pre class="quests-play-code">@q.StartCode</pre>
                            <input type="text" class="quests-play-text quests-play-code-input"
                                   name="answers[@i].Text"
                                   value="@q.TextAnswer"
                                   placeholder="Code for the ____ blank"
                                   autocomplete="off" spellcheck="false" />

                            @if (Model.Submitted && !q.IsCorrect)
                            {
                                <p class="quests-play-answer">
                                    Accepted answer(s):
                                    @for (var a = 0; a < q.AcceptedAnswers.Count; a++)
                                    {
                                        @(a > 0 ? " or " : "")<code>@q.AcceptedAnswers[a]</code>
                                    }
                                </p>
                            }
                        }
                        else
                        {
                            <p class="quests-create-hint-inline">@(q.AllowMultiple ? "Select all that apply." : "Select one.")</p>
                            <div class="quests-option-list">
                                @foreach (var option in q.Options)
                                {
                                    var isSelected = q.SelectedKeys.Contains(option.Key);
                                    var isCorrectOption = Model.Submitted && q.CorrectKeys.Contains(option.Key);
                                    var isWrongPick = Model.Submitted && isSelected && !isCorrectOption;

                                    <label class="quests-play-option @(isCorrectOption ? "is-correct" : null) @(isWrongPick ? "is-wrong" : null)">
                                        <input type="@(q.AllowMultiple ? "checkbox" : "radio")"
                                               name="answers[@i].Selected"
                                               value="@option.Key"
                                               checked="@isSelected" />
                                        <span>@option.Text</span>
                                    </label>
                                }
                            </div>
                        }

                        @if (Model.Submitted && !string.IsNullOrWhiteSpace(q.Explanation))
                        {
                            <p class="quests-play-explanation">@q.Explanation</p>
                        }
                    </fieldset>
                }

                <div class="quests-create-actions">
                    @if (!Model.Submitted)
                    {
                        <button class="quests-apply" type="submit">Submit answers</button>
                        <a class="quests-reset" asp-controller="Quests" asp-action="Quests" asp-route-section="library">Cancel</a>
                    }
                    else
                    {
                        <a class="quests-apply" asp-controller="Quests" asp-action="Play" asp-route-id="@Model.Id">Try again</a>
                        <a class="quests-reset" asp-controller="Quests" asp-action="Quests" asp-route-section="explore">Back to quests</a>
                    }
                </div>
            </form>
        </section>
    </div>
</div>

// sound effects script to choose which file should play for outcome
@section Scripts {
    <script>
        (()=>{
            const el = document.querySelector('[data-quest-outcome]');
            if(!el) return;

            const src = {
                none: '@Url.Content("~/sounds/quest-none.wav")',
                low: '@Url.Content("~/sounds/quest-low.wav")',
                high: '@Url.Content("~/sounds/quest-high.wav")' ,
                perfect: '@Url.Content("~/sounds/quest-perfect.wav")'

            }[el.dataset.questOutcome];
            if(!src) return;

            const audio = new Audio(src);
            audio.volume = 0.5;
            audio.play().catch(() => { });
        })();
    </script>
}
