@using WebApp.Models
@using WebApp.ViewModels
@model QuestCardViewModel

<article class="quest-card">
    <form class="quest-save-form" asp-controller="Quests" asp-action="ToggleSave" method="post">
        <input type="hidden" name="questId" value="@Model.Id" />
        <button class="quest-save-btn @(Model.IsSaved ? "is-saved" : null)"
                type="submit"
                aria-label="@(Model.IsSaved ? "Unsave quest" : "Save quest")">
            @(Model.IsSaved ? "★" : "☆")
        </button>
    </form>

    <h3 class="quest-card-title">@Model.Title</h3>

    @if (!string.IsNullOrEmpty(Model.CourseCode))
    {
        <p class="quest-card-code">@Model.CourseCode</p>
    }
    <p class="quest-card-meta">@(string.IsNullOrEmpty(Model.DifficultyLabel) ? Model.Difficulty.ToString() : Model.DifficultyLabel) · @Model.Points pts</p>
    @if (Model.Status != QuestStatus.NotStarted)
    {
        <p class="quest-card-status">@Model.Status</p>
        <div class="quest-progress" aria-hidden="true">
            <span class="quest-progress-fill" style="width: @(Model.ProgressPercent)%"></span>
        </div>
        <p class="quest-card-progress">@Model.ProgressPercent%</p>
    }
</article>