@using WebApp.ViewModels
@model QuestsPageViewModel

@{
    var isEdit = Model.NewQuest.Id > 0;
}

<section class="quests-create-panel">
    @if (Model.MyQuests.Count > 0)
    {
        <h2 class="quests-heading">Your quests</h2>
        <table class="quests-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Difficulty</th>
                    <th>Questions</th>
                    <th>Points</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var quest in Model.MyQuests)
                {
                    <tr>
                        <td>@quest.Title</td>
                        <td>@quest.Difficulty</td>
                        <td>@quest.QuestionCount</td>
                        <td>@quest.TotalPoints</td>
                        <td>@quest.CreatedAt.ToString("dd'/'MM'/'yyyy")</td>
                        <td>
                            <a asp-controller="Quests" asp-action="Edit" asp-route-id="@quest.Id">Edit</a> |
                            <a asp-controller="Quests" asp-action="Delete" asp-route-id="@quest.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2 class="quests-heading">@(isEdit ? "Edit quest" : "Create quest")</h2>
    <p class="quests-create-hint">Saved in the database. The quest id is assigned automatically.</p>

    <form class="quests-create-form" method="post" asp-controller="Quests"
          asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.NewQuest.Id : (int?)null)">
        <div asp-validation-summary="ModelOnly" class="quests-validation"></div>
        <input type="hidden" asp-for="NewQuest.Id" />
        <input type="hidden" asp-for="NewQuest.QuestType" />

        <div class="quests-create-grid">
            <label class="quests-create-field">
                title
                <input asp-for="NewQuest.Title" />
                <span asp-validation-for="NewQuest.Title" class="quests-validation"></span>
            </label>
            <label class="quests-create-field">
                difficulty
                <select asp-for="NewQuest.Difficulty" id="quest-difficulty">
                    <option value="">Select difficulty</option>
                    @foreach (var level in Enum.GetNames<WebApp.Models.Difficulty>())
                    {
                        <option value="@level">@level</option>
                    }
                </select>
                <span asp-validation-for="NewQuest.Difficulty" class="quests-validation"></span>
            </label>
            <label class="quests-create-field quests-create-field-wide">
                description
                <textarea asp-for="NewQuest.Description" rows="3"></textarea>
                <span asp-validation-for="NewQuest.Description" class="quests-validation"></span>
            </label>
        </div>

        <div class="quests-create-q-bar">
            <h3 class="quests-create-subheading">questions</h3>
            <button class="quests-reset" type="submit" name="addQuestion" value="1" formnovalidate>Add question</button>
        </div>

        @for (var i = 0; i < Model.NewQuest.Questions.Count; i++)
        {
            <fieldset class="quests-create-block">
                <legend>
                    Question @(i + 1)
                    @if (Model.NewQuest.Questions.Count > 1)
                    {
                        <button class="quests-remove-q" type="submit" name="removeQuestion" value="@i" formnovalidate>Remove</button>
                    }
                </legend>
                <div class="quests-create-grid">
                    <label class="quests-create-field">
                        type
                        <select asp-for="NewQuest.Questions[i].Type">
                            <option value="multipleChoice">multipleChoice</option>
                            <option value="freeText">freeText</option>
                        </select>
                        <span asp-validation-for="NewQuest.Questions[i].Type" class="quests-validation"></span>
                    </label>
                    <label class="quests-create-field">
                        points
                        <input asp-for="NewQuest.Questions[i].Points" type="number" min="0" />
                        <span asp-validation-for="NewQuest.Questions[i].Points" class="quests-validation"></span>
                    </label>
                    <label class="quests-create-field quests-create-field-wide">
                        text
                        <textarea asp-for="NewQuest.Questions[i].Question" rows="2"></textarea>
                        <span asp-validation-for="NewQuest.Questions[i].Question" class="quests-validation"></span>
                    </label>
                </div>

                <p class="quests-create-label">options</p>
                <span asp-validation-for="NewQuest.Questions[i].Options" class="quests-validation"></span>
                <div class="quests-create-grid">
                    @for (var o = 0; o < Model.NewQuest.Questions[i].Options.Count; o++)
                    {
                        <label class="quests-create-field">
                            @Model.NewQuest.Questions[i].Options[o].Id
                            <input type="hidden" asp-for="NewQuest.Questions[i].Options[o].Id" />
                            <input asp-for="NewQuest.Questions[i].Options[o].Text" />
                        </label>
                    }
                    <label class="quests-create-field">
                        correctOptionId
                        <input asp-for="NewQuest.Questions[i].CorrectOptionId" placeholder="a" />
                        <span asp-validation-for="NewQuest.Questions[i].CorrectOptionId" class="quests-validation"></span>
                    </label>
                    <label class="quests-create-field">
                        acceptedAnswers
                        <input asp-for="NewQuest.Questions[i].AcceptedAnswers" placeholder="contains()" />
                        <span asp-validation-for="NewQuest.Questions[i].AcceptedAnswers" class="quests-validation"></span>
                    </label>
                    <label class="quests-create-field quests-create-field-wide">
                        explaination
                        <textarea asp-for="NewQuest.Questions[i].Explaination" rows="2"></textarea>
                    </label>
                </div>
            </fieldset>
        }

        <div class="quests-create-actions">
            <button class="quests-apply" type="submit">Save quest</button>
            <a class="quests-reset" asp-controller="Quests" asp-action="Quests" asp-route-section="@(isEdit ? "create" : "library")">Cancel</a>
        </div>
    </form>
    
    <dialog id="difficulty-dialog" class="quests-dialog">
        <h3>Difficulty not selected</h3>
        <p>You need to choose a difficulty before the quest can be saved.</p>
        <div class="quests-create-actions">
            <button type="button" class="quests-apply" id="difficulty-keep">Keep editing</button>
            <button type="button" class="quests-reset" id="difficulty-cancel"
                    data-cancel-url="@Url.Action("Quests", "Quests", new { section = isEdit ? "create" : "library" })">
                Cancel quest
            </button>
        </div>
    </dialog>

    <script>
        (function () {
            const form = document.querySelector(".quests-create-form");
            const select = document.getElementById("quest-difficulty");
            const dialog = document.getElementById("difficulty-dialog");

            form.addEventListener("submit", function (e) {
                // Let the "add question" / "remove question" buttons through
                const name = e.submitter ? e.submitter.name : "";
                if (name === "addQuestion" || name === "removeQuestion") return;

                if (!select.value) {
                    e.preventDefault();
                    dialog.showModal();
                }
            });

            document.getElementById("difficulty-keep").addEventListener("click", function () {
                dialog.close();
                select.focus();
            });

            document.getElementById("difficulty-cancel").addEventListener("click", function () {
                window.location.href = this.dataset.cancelUrl;
            });
        })();
    </script>
</section>