@using WebApp.ViewModels
@{
    ViewData["Welcome to ####"] = "Home Page";

    // The signed-in user's code points from completed quests (set by HomeController)
    int streakCount = ViewData["Streak"] as int? ?? 0;
    int totalXp = ViewData["CodePoints"] as int? ?? 0;
    var weekActivity = ViewData["WeekActivity"] as List<bool> ?? new List<bool> { false, false, false, false, false, false, false };
    var topUsers = ViewData["TopUsers"] as List<LeaderboardEntryViewModel> ?? new List<LeaderboardEntryViewModel>();
    string[] dayLabels = ["M", "T", "W", "T", "F", "S", "S"];
}

<div class="home-container">
    <div class="home-grid-3col">
        <!-- LEFT: Weekly streak and a space for challenges -->
        <div class="home-left-column">
        <aside class="side-card streak-card">
            <div class="side-card-header">
                <h3>Weekly Streak</h3>
                <span class="streak-pill">@streakCount</span>
            </div>
            <p class="side-card-subtext">Complete a quest each day to keep your flame alive.</p>

            <div class="week-tracker">
                @for (int i = 0; i < 7; i++)
                {
                    bool isActive = i < weekActivity.Count && weekActivity[i];
                    <div class="day-column">
                        <span class="day-label">@dayLabels[i]</span>
                        <div class="day-circle @(isActive ? "active" : "")">
                            @if (isActive)
                            {
                                <span>✓</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </aside>

        <section class="side-card home-challenge-card">
            <div class="side-card-header">
                <h3>Challenges</h3>
            </div>
        </section>
        </div>

        <!-- CENTER: Welcome & Stats -->
        <div class="welcome">
            <span class="badge">Hit new heights with da code</span>

            <h1 class="welcome-title">@(User.Identity?.IsAuthenticated == true ? $"Welcome back, {User.Identity.Name}!" : "Welcome!")</h1>

            <div class="user-stats-row">
                <div class="stat-badge">
                    <span class="stat-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-fire" viewBox="0 0 16 16">
                            <path d="M8 16c3.314 0 6-2 6-5.5 0-1.5-.5-4-2.5-6 .25 1.5-1.25 2-1.25 2C11 4 9 .5 6 0c.357 2 .5 4-2 6-1.25 1-2 2.729-2 4.5C2 14 4.686 16 8 16m0-1c-1.657 0-3-1-3-2.75 0-.75.25-2 1.25-3C6.125 10 7 10.5 7 10.5c-.375-1.25.5-3.25 2-3.5-.179 1-.25 2 1 3 .625.5 1 1.364 1 2.25C11 14 9.657 15 8 15" />
                        </svg>
                    </span>
                    <span class="stat-value">@streakCount Days</span>
                    <span class="stat-label">Streak</span>
                </div>
                <div class="stat-badge">
                    <span class="stat-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-lightning-charge" viewBox="0 0 16 16">
                            <path d="M11.251.068a.5.5 0 0 1 .227.58L9.677 6.5H13a.5.5 0 0 1 .364.843l-8 8.5a.5.5 0 0 1-.842-.49L6.323 9.5H3a.5.5 0 0 1-.364-.843l8-8.5a.5.5 0 0 1 .615-.09zM4.157 8.5H7a.5.5 0 0 1 .478.647L6.11 13.59l5.732-6.09H9a.5.5 0 0 1-.478-.647L9.89 2.41z" />
                        </svg>
                    </span>
                    <span class="stat-value">@totalXp</span>
                    <span class="stat-label">Total XP</span>
                </div>
            </div>

            <p class="site-desc">
                Level up your coding skills with quests, challenges and compete on the leaderboard! Master your craft and become better than ever before!
            </p>

            <div class="quest-invite">
                <p class="quest-invite-text">Start questing now!</p>
                <a class="btn-quest-explore" asp-controller="Quests" asp-action="Quests">Explore Quests</a>
            </div>
        </div>

        <!-- Mini Leaderboard -->
        <aside class="side-card mini-leaderboard-card">
            <div class="side-card-header">
                <h3>Top Learners</h3>
            </div>

            @if (topUsers.Count == 0)
            {
                <p class="side-card-subtext">No scores recorded yet. Be the first!</p>
            }
            else
            {
                <ul class="mini-lb-list">
                    @foreach (var entry in topUsers)
                    {
                        <li class="mini-lb-item">
                            <span class="mini-lb-rank rank-@entry.Rank">#@entry.Rank</span>
                            <span class="mini-lb-name">@entry.Name</span>
                            <span class="mini-lb-pts">@entry.Points XP</span>
                        </li>
                    }
                </ul>
            }

            <a class="btn-quest-explore" asp-controller="Leaderboard" asp-action="Leaderboard">View Leaderboard →</a>
        </aside>
    </div>
</div>
           