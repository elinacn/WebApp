@{
    ViewData["Welcome to ####"] = "Home Page";

    //temp data for testing and layout
    int streakCount = 5;
    int totalXp = 1250;
    string rankName = "Noob";
    int rankPoints = 67;
}

<div class="home-container">
    <!-- dashboard box -->
    <div class="dashboard-grid">
        <!-- welcome box with info -->
        <div class="welcome">
            <span class="badge">Hit new hights with da code</span>

            <h1 class="welcome-title">Welcome back, Test_User!</h1>
            <!-- streak and xp details with temp data -->
            <div class="user-stats-row">
                <div class="stat-badge">
                    <span class="stat-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-fire" viewBox="0 0 16 16"> <path d="M8 16c3.314 0 6-2 6-5.5 0-1.5-.5-4-2.5-6 .25 1.5-1.25 2-1.25 2C11 4 9 .5 6 0c.357 2 .5 4-2 6-1.25 1-2 2.729-2 4.5C2 14 4.686 16 8 16m0-1c-1.657 0-3-1-3-2.75 0-.75.25-2 1.25-3C6.125 10 7 10.5 7 10.5c-.375-1.25.5-3.25 2-3.5-.179 1-.25 2 1 3 .625.5 1 1.364 1 2.25C11 14 9.657 15 8 15"/></svg></i></span>
                    <span class="stat-value">@streakCount Days</span>
                    <span class="stat-label">Streak</span>
                </div>
                <div class="stat-badge">
                    <span class="stat-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-lightning-charge" viewBox="0 0 16 16"><path d="M11.251.068a.5.5 0 0 1 .227.58L9.677 6.5H13a.5.5 0 0 1 .364.843l-8 8.5a.5.5 0 0 1-.842-.49L6.323 9.5H3a.5.5 0 0 1-.364-.843l8-8.5a.5.5 0 0 1 .615-.09zM4.157 8.5H7a.5.5 0 0 1 .478.647L6.11 13.59l5.732-6.09H9a.5.5 0 0 1-.478-.647L9.89 2.41z"/></svg></span>
                    <span class="stat-value">@totalXp</span>
                    <span class="stat-label">Total XP</span>
                </div>
            </div>

            <p class="site-desc">
                Level up your coding skills with quests, challenges and compete on the leaderboard! Master your craft and become better than ever before!
            </p>

            <div class="quest-invite">
                <p class="quest-invite-text">Start questing now!</p> 

                <a class="btn-quest-explore" asp-controller="Quests" asp-action="Quests">Explore Quests</a>
            </div>
        </div>
            <div class="rank-section">
                <div class="rank-header">
                    <span class="rank-icon"><svg xmlns="http://w3.org" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
  <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3a1 1 0 01-1 1H6a1 1 0 01-1-1v-1h14v1z"/>
</svg></span>
                    <h3>Current Rank</h3>
                </div>

                <div class="rank-content">
                    <div class="rank-badge-display">
                        <span class="rank-tier">@rankName</span>
                    </div>

                    <div class="rank-details">
                        <div class="rank-info-row">
                            <span class="info-label">Rank Points:</span>
                            <span class="info-value">@rankPoints Code Points</span>
                        </div>
                        
                        <a class="btn-leaderboard-link" asp-controller="Leaderboard" asp-action="Leaderboard">View Leaderboard</a>

                    </div>
                </div>
            </div>
    </div>
</div>