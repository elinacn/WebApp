<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- navbar -->
    <header class="site-navbar">
        <div class="navbar-container">
            <nav class="navbar-menu" itemid="navbarMenu">
                <ul class="navbar-links">
                    <!-- eventual redirects to the other pages when they get implemented-->
                    <li><a class="nav-item-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a class="nav-item-link" asp-controller="Quests" asp-action="Quests">Quests</a></li>
                    <li><a class="nav-item-link" asp-controller="Leaderboard" asp-action="Leaderboard">Leaderboard</a></li>
                    <li><a class="nav-item-link" asp-controller="Sheets" asp-action="Index">Sheets</a></li>
                </ul>
            </nav>

        <div class="navbar-auth">
            <!-- identifies user and shows different options based on if they are logged in or not-->
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <!-- eventually add a default picture users are assigned on login after implemented in DB-->
               var profilePic = User.FindFirst("ProfilePicture")?.Value ?? Url.Content("~/images/default-profile.png");
                
                <div class="dropdown profile-dropdown">
                    <a href="#" class="profile-dropdown-toggle" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="@profilePic" alt="Profile" class="profile-avatar-img" />
                    </a>
                    <!-- dropdown menu for profile options, yet to implement settings and logout-->
                    <ul class="dropdown-menu dropdown-menu-end custom-dropdown-menu" aria-labelledby="profileDropdownMenuLink">
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Profile">Profile</a></li>
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Settings">Settings</a></li>
                        <li><hr class="dropdown-divider bg-secondary"></li>
                        <li>
                            <form class="form-inline" asp-controller="#" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger">Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <!-- eventual redirects to the login and register pages when they get implemented-->
                <a class="navbar-login-btn" asp-controller="#" asp-action="Login">Login</a>
                <a class="navbar-register-btn" asp-controller="#" asp-action="Register">Register</a>
            }

        </div>
        </a>
       </div>
    </header>

    <div class="main-content-wrapper">
        <main role="main">
            @if (TempData["Success"] is string success)
            {
                <div class="container pt-3"><div class="alert alert-success mb-0" role="status">@success</div></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="container pt-3"><div class="alert alert-danger mb-0" role="alert">@error</div></div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="footer-container text-center">
            &copy; 2026 - WebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
