@using WebApp.Extensions
@model User
@{
    ViewData["Title"] = "Edit user";
}

<div class="container py-4 text-light" data-bs-theme="dark">
    <h1>Edit user</h1>

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StudyProgram" class="form-label"></label>
            <input asp-for="StudyProgram" class="form-control" />
            <span asp-validation-for="StudyProgram" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CreatedAt" class="form-label"></label>
            <input asp-for="CreatedAt" class="form-control" />
            <span asp-validation-for="CreatedAt" class="text-danger"></span>
        </div>

        @if (Model.Id == User.GetUserId())
        {
        <div class="mb-3">
            <label for="currentPassword" class="form-label">Current password</label>
            <input id="currentPassword" name="currentPassword" type="password" class="form-control" autocomplete="current-password" />
            <div class="form-text text-secondary">Required only when setting a new password.</div>
            @Html.ValidationMessage("currentPassword", new { @class = "text-danger" })
        </div>

        }

        <div class="mb-3">
            <label for="newPassword" class="form-label">New password</label>
            <input id="newPassword" name="newPassword" type="password" class="form-control" autocomplete="new-password" />
            <div class="form-text text-secondary">Leave empty to keep the current password. At least @PasswordRules.MinLength characters.</div>
            @Html.ValidationMessage("newPassword", new { @class = "text-danger" })
        </div>

        @if (User.IsInRole(WebApp.Models.AppRoles.Admin))
        {
            <div class="mb-3 form-check">
                <input asp-for="IsAdmin" class="form-check-input" />
                <label asp-for="IsAdmin" class="form-check-label">Admin access</label>
                <span asp-validation-for="IsAdmin" class="text-danger"></span>
            </div>
        }

        <button type="submit" class="btn btn-primary">Save</button>
        @if (User.IsInRole(WebApp.Models.AppRoles.Admin))
        {
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        }
        else
        {
            <a asp-controller="Profile" asp-action="Profile" class="btn btn-secondary">Cancel</a>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
