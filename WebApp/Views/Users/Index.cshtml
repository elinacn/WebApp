@model IEnumerable<User>
@{
    ViewData["Title"] = "Users";
}

<div class="container py-4 text-light" data-bs-theme="dark">
    <h1>Users</h1>

    <p><a asp-action="Create" class="btn btn-primary">New user</a></p>

    @if (!Model.Any())
    {
        <p>No users yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>@Html.DisplayNameFor(m => m.Username)</th>
                    <th>@Html.DisplayNameFor(m => m.Name)</th>
                    <th>@Html.DisplayNameFor(m => m.Course)</th>
                    <th>@Html.DisplayNameFor(m => m.QuizzesCompleted)</th>
                    <th>@Html.DisplayNameFor(m => m.Points)</th>
                    <th>@Html.DisplayNameFor(m => m.CreatedAt)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@Html.DisplayFor(_ => item.Username)</td>
                        <td>@Html.DisplayFor(_ => item.Name)</td>
                        <td>@Html.DisplayFor(_ => item.Course)</td>
                        <td>@Html.DisplayFor(_ => item.QuizzesCompleted)</td>
                        <td>@Html.DisplayFor(_ => item.Points)</td>
                        <td>@Html.DisplayFor(_ => item.CreatedAt)</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
