@model Course
@{
    ViewData["Title"] = "Delete course";
}

<div class="container py-4 text-light" data-bs-theme="dark">
    <h1>Delete course</h1>
    <p class="text-danger">Are you sure you want to delete this course?</p>

    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Code)</dt>
        <dd class="col-sm-9">@Model.Code</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Title)</dt>
        <dd class="col-sm-9">@Model.Title</dd>
    </dl>

    @if (Model.Quests.Count > 0)
    {
        <div class="alert alert-warning">
            The quests below are not deleted, but they will no longer belong to any course.
        </div>
        <partial name="_CourseQuests" model="Model" />
    }

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
